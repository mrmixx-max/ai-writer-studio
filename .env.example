# .env.example — kopieren nach .env und anpassen
# Nie .env committen (steht in .gitignore)

# OpenAI Cloud-Provider (optional, nur wenn genutzt)
OPENAI_API_KEY=sk-your-key-here

# OpenRouter Cloud-Provider (optional)
OPENROUTER_API_KEY=sk-or-your-key-here

# Lokale Provider-Standard-Endpunkte
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234/v1
GPT2API_BASE_URL=http://localhost:8080/v1

# Globaler Standard-Provider: ollama | lmstudio | openai | openrouter | gpt2api
DEFAULT_PROVIDER=ollama
