{
  "name": "ai-writer-studio",
  "version": "1.0.0",
  "description": "Desktop-Schreibsoftware für Autoren mit integriertem KI-Assistenten (Ollama / LM Studio / OpenAI)",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:vite": "vite",
    "prebuild": "python scripts/copy_wasm.py",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "release": "node scripts/release.mjs",
    "prepare": "husky",
    "tauri": "tauri",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "build:windows": "powershell -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "installer": "powershell -ExecutionPolicy Bypass -File scripts/create-installer.ps1",
    "release:windows": "powershell -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -CreateInstaller",
    "release:full": "powershell -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -CreateInstaller -Sign -Portable -UpdateArtifacts",
    "portable": "powershell -ExecutionPolicy Bypass -File scripts/create-portable.ps1",
    "sign": "powershell -ExecutionPolicy Bypass -File scripts/sign-binary.ps1",
    "update:manifest": "powershell -ExecutionPolicy Bypass -File scripts/generate-update-manifest.ps1",
    "update:delta": "powershell -ExecutionPolicy Bypass -File scripts/generate-delta.ps1",
    "icons": "powershell -ExecutionPolicy Bypass -File scripts/generate-icons.ps1",
    "test:e2e": "vitest run src/services/bookwriter/workflow.e2e.test.ts",
    "pipeline": "powershell -ExecutionPolicy Bypass -File scripts/e2e-bookwriter.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.0.1",
    "@tauri-apps/plugin-fs": "^2.0.3",
    "@tauri-apps/plugin-process": "^2.0.1",
    "@tauri-apps/plugin-shell": "^2.0.1",
    "@tiptap/core": "^2.10.3",
    "@tiptap/extension-blockquote": "^2.10.3",
    "@tiptap/extension-bold": "^2.10.3",
    "@tiptap/extension-bubble-menu": "^2.10.3",
    "@tiptap/extension-bullet-list": "^2.10.3",
    "@tiptap/extension-document": "^2.10.3",
    "@tiptap/extension-dropcursor": "^2.10.3",
    "@tiptap/extension-gapcursor": "^2.10.3",
    "@tiptap/extension-heading": "^2.10.3",
    "@tiptap/extension-history": "^2.10.3",
    "@tiptap/extension-italic": "^2.10.3",
    "@tiptap/extension-list-item": "^2.10.3",
    "@tiptap/extension-ordered-list": "^2.10.3",
    "@tiptap/extension-paragraph": "^2.10.3",
    "@tiptap/extension-placeholder": "^2.10.3",
    "@tiptap/extension-text": "^2.10.3",
    "@tiptap/pm": "^2.10.3",
    "@tiptap/react": "^2.10.3",
    "@tiptap/starter-kit": "^2.10.3",
    "docx": "^9.7.1",
    "epubjs": "^0.3.93",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.11.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.11",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "happy-dom": "^20.11.12",
    "husky": "^9.1.7",
    "js-yaml": "^4.3.2",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^5.4.11",
    "vitest": "^4.1.11"
  }
}
