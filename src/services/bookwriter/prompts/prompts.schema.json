{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Writer Studio Prompt Library",
  "description": "Externe Prompt-Templates (Handlebars) + Genre-Profile + Stil-Presets fuer den Bookwriter. Sprint 6, Agent 2; Sprint 7, Agent 3 (styles).",
  "type": "object",
  "required": [
    "version",
    "defaultGenre",
    "genres"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "defaultGenre": {
      "type": "string"
    },
    "styles": {
      "type": "array",
      "description": "Vordefinierte Stil/Ton-Presets (Sprint 7, Agent 3). Optional: alte Libraries ohne styles bleiben valid.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "description",
          "systemHint",
          "rules"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "systemHint": {
            "type": "string",
            "minLength": 1
          },
          "rules": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "genres": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "label",
          "systemRole",
          "systemRules",
          "prompts"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "systemRole": {
            "type": "string",
            "minLength": 1
          },
          "systemRules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "prompts": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
